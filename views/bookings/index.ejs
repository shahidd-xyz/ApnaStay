<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/myBookings.css">

<div class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            My Bookings
        </h2>

        <p class="text-muted">
            View all your booking requests and their current status.
        </p>

    </div>

    <% if(bookings.length === 0){ %>

        <div class="alert alert-info text-center">

            You haven't booked any stays yet.

        </div>

    <% } else { %>

        <% bookings.forEach((booking)=>{ %>

            <div class="card booking-card shadow-sm mb-5 mt-5">

                <div class="row g-0">

                    <!-- Image -->

                    <div class="col-lg-4">

                        <img
                            src="<%= booking.listing.image.url %>"
                            class="booking-img"
                            alt="<%= booking.listing.title %>"
                        >

                    </div>

                    <!-- Details -->

                    <div class="col-lg-8">

                        <div class="card-body p-4 ms-5">

                            <h3 class="fw-bold">

                                <%= booking.listing.title %>

                            </h3>

                            <p class="text-muted mb-3">

                                <i class="fa-solid fa-location-dot me-2"></i>

                                <%= booking.listing.location %>,
                                <%= booking.listing.country %>

                            </p>

                            <div class="row">

                                <div class="col-md-6">

                                    <p>

                                        <strong>Check-in:</strong>

                                        <%= booking.checkIn.toLocaleDateString("en-IN",{
                                            day:"numeric",
                                            month:"short",
                                            year:"numeric"
                                        }) %>

                                    </p>

                                    <p>

                                        <strong>Check-out:</strong>

                                        <%= booking.checkOut.toLocaleDateString("en-IN",{
                                            day:"numeric",
                                            month:"short",
                                            year:"numeric"
                                        }) %>

                                    </p>

                                </div>

                                <div class="col-md-6">

                                    <p>

                                        <strong>Guests:</strong>

                                        <%= booking.guests %>

                                    </p>

                                    <p>

                                        <strong>Status:</strong>

                                        <% if(booking.status==="Pending"){ %>

                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>

                                        <% } %>

                                        <% if(booking.status==="Accepted"){ %>

                                            <span class="badge bg-success">

                                                Accepted

                                            </span>

                                        <% } %>

                                        <% if(booking.status==="Rejected"){ %>

                                            <span class="badge bg-danger">

                                                Rejected

                                            </span>

                                        <% } %>

                                    </p>

                                </div>

                            </div>

                            <hr>

                            <p>

                                <strong>Special Request</strong>

                            </p>

                            <p class="text-muted">

                                <%= booking.specialRequest || "No special request provided." %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>