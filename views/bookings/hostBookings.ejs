<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/hostBookings.css">

<div class="container py-5">

    <h2 class="text-center fw-bold mb-5">
        Booking Requests
    </h2>

    <% if (bookings.length === 0) { %>

        <div class="alert alert-info text-center">
            No booking requests yet.
        </div>

    <% } else { %>

        <% bookings.forEach((booking) => { %>

            <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">

                <div class="row g-0">

                    <!-- Listing Image -->
                    <div class="col-lg-4">

                        <img
                            src="<%= booking.listing.image.url %>"
                            alt="<%= booking.listing.title %>"
                            class="booking-img img-fluid w-100 h-100"
                        >

                    </div>

                    <!-- Booking Details -->
                    <div class="col-lg-8">

                        <div class="card-body p-4">

                            <h3 class="fw-bold mb-2">
                                <%= booking.listing.title %>
                            </h3>

                            <p class="text-muted mb-4">
                                <i class="fa-solid fa-location-dot me-2"></i>
                                <%= booking.listing.location %>,
                                <%= booking.listing.country %>
                            </p>

                            <hr>

                            <div class="row">

                                <!-- Guest Details -->

                                <div class="col-md-6">

                                    <p>
                                        <strong>Guest:</strong>
                                        <%= booking.guest.username %>
                                    </p>

                                    <p>
                                        <strong>Guests:</strong>
                                        <%= booking.guests %>
                                    </p>

                                    <p>
                                        <strong>Phone:</strong>
                                        <%= booking.phone || "Not Provided" %>
                                    </p>

                                </div>

                                <!-- Booking Details -->

                                <div class="col-md-6">

                                    <p>
                                        <strong>Check-in:</strong>

                                        <%= booking.checkIn.toLocaleDateString("en-IN", {
                                            day: "numeric",
                                            month: "short",
                                            year: "numeric"
                                        }) %>

                                    </p>

                                    <p>
                                        <strong>Check-out:</strong>

                                        <%= booking.checkOut.toLocaleDateString("en-IN", {
                                            day: "numeric",
                                            month: "short",
                                            year: "numeric"
                                        }) %>

                                    </p>

                                    <p>

                                        <strong>Status:</strong>

                                        <% if (booking.status === "Pending") { %>

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                        <% } else if (booking.status === "Accepted") { %>

                                            <span class="badge bg-success">
                                                Accepted
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>

                                        <% } %>

                                    </p>

                                </div>

                            </div>

                            <hr>

                            <h6 class="fw-bold">
                                Special Request
                            </h6>

                            <p class="mb-4">
                                <%= booking.specialRequest || "No special requests provided." %>
                            </p>

                            <% if (booking.status === "Pending") { %>

                                <div class="d-flex gap-3">

                                    <form
                                        action="/listings/<%= booking.listing._id %>/bookings/<%= booking._id %>/accept?_method=PATCH"
                                        method="POST"
                                    >

                                        <button class="btn btn-success px-4">

                                            <i class="fa-solid fa-check me-2"></i>

                                            Accept

                                        </button>

                                    </form>

                                    <form
                                        action="/listings/<%= booking.listing._id %>/bookings/<%= booking._id %>/reject?_method=PATCH"
                                        method="POST"
                                    >

                                        <button class="btn btn-danger px-4">

                                            <i class="fa-solid fa-xmark me-2"></i>

                                            Reject

                                        </button>

                                    </form>

                                </div>

                            <% } %>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>