<style>
  .navbar {
    background: #fff;
    padding: 0.9rem 2rem;
    box-shadow: 0 2px 15px rgba(0, 0, 0, .05);
  }

  .navbar-brand img {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 50%;
  }

  .navbar-nav .nav-link {
    color: #fe424d !important;
    font-weight: 500;
    margin: 0 .35rem;
    transition: .25s;
  }

  .navbar-nav .nav-link:hover {
    color: #fe424d !important;
  }

  /* Search */

  .search-form {
    display: flex;
    align-items: center;
  }

  .search-inp {
    border-radius: 30px;
    padding: .65rem 1.3rem;
    width: 260px;
    border: 1px solid #dee2e6;
    box-shadow: none;
  }

  .search-inp:focus {
    border-color: #fe424d;
    box-shadow: 0 0 0 .15rem rgba(254, 66, 77, .15);
  }

  .search-btn {
    margin-left: .6rem;
    background: #fe424d;
    color: #fff;
    border: none;
    border-radius: 30px;
    padding: .65rem 1.3rem;
    font-weight: 600;
    transition: .3s;
  }

  .search-btn:hover {
    background: #e63946;
    color: #fff;
  }

  .search-btn i {
    margin-right: .45rem;
  }

  /* Action Buttons */

  .nav-btn {
    padding: .55rem 1.15rem !important;
    border-radius: 30px;
    font-weight: 600;
    transition: .3s;
    margin-left: .5rem;
  }

  .navbar-nav .host-btn {
    border: 2px solid #fe424d;
    color: #fe424d !important;
  }

  .navbar-nav .host-btn:hover {
    background: #fe424d;
    color: #ffffff !important;
  }

  .navbar-nav .signup-btn {
    background: #fe424d;
    color: #fff !important;
  }

  .navbar-nav .signup-btn:hover {
    background: #e63946;
    color: #ffffff !important;
  }

  .login-btn {
    border: 2px solid #fe424d;
    color: #fe424d !important;
  }

  .navbar-nav .login-btn:hover {
    background: #fe424d;
    color: #ffffff !important;
  }

  .navbar-nav .logout-btn {
    background: #fff;
    color: #000 !important;
  }

  .navbar-nav .logout-btn:hover {
    background: #000;
    color: #fff !important;
  }

  @media(max-width:768px) {

    .navbar {
      padding: 1rem;
    }

    .search-form {
      margin: 1rem 0;
      width: 100%;
    }

    .search-inp {
      width: 100%;
    }

    .nav-btn {
      margin: .35rem 0;
      text-align: center;
    }
  }
</style>

<nav class="navbar navbar-expand-md sticky-top">

  <div class="container-fluid">

    <a class="navbar-brand" href="/listings">
      <img src="/images/logo_apnastay.jpeg" alt="ApnaStay">
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">

      <span class="navbar-toggler-icon"></span>

    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <div class="navbar-nav">

        <a class="nav-link fw-semibold" href="/listings">
          Explore Now!
        </a>

      </div>

      <div class="navbar-nav ms-auto">

        <form class="search-form" role="search">

          <input class="form-control search-inp" type="search" placeholder="Search destination">

          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
          </button>

        </form>

      </div>

      <div class="navbar-nav ms-auto align-items-center">

        <a class="nav-link nav-btn host-btn" href="/listings/new">
          <i class="fa-solid fa-house me-1"></i>
          Add your home
        </a>

        <% if(!currentUser){ %>

          <a class="nav-link nav-btn signup-btn" href="/signup">
            Sign Up
          </a>

          <a class="nav-link nav-btn login-btn" href="/login">
            Login
          </a>

          <% } %>

            <% if(currentUser){ %>

              <a class="nav-link nav-btn logout-btn" href="/logout">
                Logout
              </a>

              <% } %>

      </div>

    </div>

  </div>

</nav>