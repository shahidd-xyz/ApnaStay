<% layout("/layouts/boilerplate") %>

<style>
  .login-page {
    background: #ffffff;
    min-height: calc(100vh - 76px);
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem 1rem;
  }

  .login-page .login-card {
    width: 100%;
    max-width: 560px;
    background: #fff;
    border: none;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
  }

  .login-page .login-header {
    text-align: center;
    padding: 3rem 3rem 2rem;
  }

  .login-page .login-logo {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .login-page .login-title {
    font-size: 2rem;
    font-weight: 700;
    color: #212529;
    margin-bottom: 0.5rem;
  }

  .login-page .login-subtitle {
    color: #6c757d;
    font-size: 1rem;
    margin-bottom: 0;
  }

  .login-page .login-body {
    padding: 0 3rem 3rem;
  }

  .login-page .input-box {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .login-page .input-box i {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #6c757d;
    font-size: 1rem;
  }

  .login-page .login-input {
    height: 60px;
    border-radius: 15px;
    padding-left: 50px;
    font-size: 1rem;
    border: 1px solid #dee2e6;
    transition: 0.3s;
  }

  .login-page .login-input:focus {
    border-color: #fe424d;
    box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.15);
  }

  .login-page .login-btn {
    width: 100%;
    height: 60px;
    border: none;
    border-radius: 15px;
    background: #fe424d;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    transition: 0.3s;
  }

  .login-page .login-btn:hover {
    background: #e63946;
    color: #fff;
  }

  .login-page .signup-text {
    margin-top: 2rem;
    text-align: center;
    color: #6c757d;
  }

  .login-page .signup-link {
    color: #fe424d;
    text-decoration: none;
    font-weight: 600;
  }

  .login-page .signup-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .login-page {
      padding: 2rem 1rem;
    }

    .login-page .login-header {
      padding: 2rem;
    }

    .login-page .login-body {
      padding: 0 2rem 2rem;
    }

    .login-page .login-card {
      max-width: 100%;
    }

    .login-page .login-logo {
      width: 75px;
      height: 75px;
    }

    .login-page .login-title {
      font-size: 1.7rem;
    }

    .login-page .login-input,
    .login-page .login-btn {
      height: 55px;
    }
  }
</style>

<div class="login-page">
  <div class="card login-card">
    <div class="login-header">
      <img
        src="/images/logo_apnastay.jpeg"
        alt="ApnaStay Logo"
        class="login-logo"
      />

      <h2 class="login-title">Welcome Back</h2>

      <p class="login-subtitle">
        Login to continue exploring homes with ApnaStay.
      </p>
    </div>

    <div class="login-body">
      <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="input-box">
          <i class="fa-solid fa-user"></i>

          <input
            type="text"
            name="username"
            id="username"
            class="form-control login-input"
            placeholder="Enter your username"
            required
          />

          <div class="invalid-feedback">Please enter your username.</div>
        </div>

        <div class="input-box">
          <i class="fa-solid fa-lock"></i>

          <input
            type="password"
            name="password"
            id="password"
            class="form-control login-input"
            placeholder="Enter your password"
            required
          />

          <div class="invalid-feedback">Please enter your password.</div>
        </div>

        <button type="submit" class="btn login-btn">Login</button>
      </form>

      <div class="signup-text">
        Don't have an account?
        <a href="/signup" class="signup-link">Create Account</a>
      </div>
    </div>
  </div>
</div>
